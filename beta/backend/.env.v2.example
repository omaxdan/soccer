# ─────────────────────────────────────────────────────────────────────────────
# PitchTerminal V2 — backend environment
#
# ADDITIVE. V1 keeps using .env exactly as before; nothing here is required by
# any V1 job, and src/config/index.ts is not aware of these variables. A process
# that runs only V1 work needs none of them.
#
# Copy the lines you need into .env. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# ── Connection ───────────────────────────────────────────────────────────────
PT_V2_DB_HOST=db.<project>.supabase.co
PT_V2_DB_NAME=postgres

# SESSION MODE ONLY. 5432 is the direct connection; 6543 is the transaction
# pooler and is refused outright.
#
# R-58: pipeline connections operate in session mode because bulk write paths
# depend on session-scoped state — the retention marker of R-21 and the timeout
# settings of A.15 — that transaction pooling does not preserve. A pooled
# connection does not fail loudly: the marker would not survive to the next
# statement, the DELETE policy would match nothing, and retention would report
# success having removed nothing.
PT_V2_DB_PORT=5432

PT_V2_DB_SSL=true
PT_V2_DB_CONNECT_TIMEOUT_MS=10000
PT_V2_DB_IDLE_TIMEOUT_MS=30000

# Prefix for application_name, so pg_stat_activity attributes every session to a
# role and the connection budget of R-05 is observable rather than inferred.
PT_V2_APP_NAME=pitchterminal-v2

# ── Credentials, one per role ────────────────────────────────────────────────
# Set ONLY the roles this process uses. A host that holds all seven yields all
# seven if it is compromised, and no process needs all seven.
#
# Roles are created NOLOGIN by migration 001; LOGIN and credentials are granted
# through a secure channel outside version control — a migration file is not a
# place for a credential (§B.7.1).
#
# Role names are NOT configurable. Only the secret varies per deployment.

# pt_pipeline_ingestion  — writes football from provider feeds
PT_V2_DB_PASSWORD_INGESTION=

# pt_pipeline_feature    — writes feature; reads football
PT_V2_DB_PASSWORD_FEATURE=

# pt_pipeline_module     — writes module and snapshot; seals
PT_V2_DB_PASSWORD_MODULE=

# pt_pipeline_calibration — writes calibration, and the two snapshot
#                           outcome-link relations ONLY (R-67). Keep this
#                           credential separate from the module role: a single
#                           shared secret would give calibration the ability to
#                           create snapshots.
PT_V2_DB_PASSWORD_CALIBRATION=

# pt_pipeline_projection — refreshes product projections and materialised views
PT_V2_DB_PASSWORD_PROJECTION=

# pt_retention           — sole holder of DELETE on thinnable relations, under
#                          the session marker (R-20, R-22)
PT_V2_DB_PASSWORD_RETENTION=

# pt_platform_admin      — reads every schema; writes governed configuration
PT_V2_DB_PASSWORD_ADMIN=

# ── Pool sizing (optional) ───────────────────────────────────────────────────
# Defaults total 20 connections across all seven roles and are deliberately
# small: session-mode connections are not multiplexed, and Phase 8 R-05
# registers slot exhaustion as a High risk. Set these once the direct-connection
# budget of §13 Stage 2 is known.
#
# Minimum 2 for any role running attributed work: withRun() holds a second
# connection for the job lifecycle, which must commit outside the work
# transaction so a failed run still leaves a record.
#
# PT_V2_POOL_MAX_INGESTION=4
# PT_V2_POOL_MAX_FEATURE=4
# PT_V2_POOL_MAX_MODULE=4
# PT_V2_POOL_MAX_CALIBRATION=2
# PT_V2_POOL_MAX_PROJECTION=3
# PT_V2_POOL_MAX_RETENTION=2
# PT_V2_POOL_MAX_ADMIN=2

# ── Local development / CI only ──────────────────────────────────────────────
# Permits a non-standard port. NEVER set this in a deployed environment: it
# disables the one check that catches a pipeline pointed at a pooler.
# PT_V2_ALLOW_NON_SESSION_PORT=false

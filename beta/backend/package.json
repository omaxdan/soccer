{
  "name": "ninetydata-beta-backend",
  "version": "2.0.0",
  "description": "NinetyData RIP beta backend \u2014 single-writer pipeline (audit-hardened)",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc",
    "cli": "ts-node src/cli.ts",
    "lint:reads": "bash scripts/check-raw-reads.sh",
    "test": "tsc --noEmit && node --test --import tsx \"src/**/*.test.ts\"",
    "seed:v2": "tsx src/v2/seed/runAll.ts",
    "ingest:v2": "tsx src/v2/ingestion/cli.ts",
    "ingest:v2:governed": "tsx src/v2/ingestion/orchestration/governedSeason.ts",
    "ingest:v2:governed-all": "tsx src/v2/ingestion/orchestration/governedEditions.ts",
    "governance:register": "tsx src/v2/ingestion/orchestration/governanceAdmin.ts register",
    "governance:link": "tsx src/v2/ingestion/orchestration/governanceAdmin.ts link",
    "feature:v2": "tsx src/v2/feature/cli.ts",
    "module:v2": "tsx src/v2/module/cli.ts",
    "snapshot:v2": "tsx src/v2/snapshot/cli.ts",
    "calibration:v2": "tsx src/v2/calibration/cli.ts",
    "api:v2": "tsx src/v2/api/server.ts",
    "doctor:v2": "tsx src/v2/db/doctor.ts",
    "discover:v2": "tsx src/v2/ingestion/discover.ts",
    "quality:v2": "tsx src/v2/quality/cli.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "pg": "^8.22.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/pg": "^8.20.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.23.1",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

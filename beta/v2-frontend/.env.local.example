# PitchTerminal V2 frontend — local environment example. Copy to .env.local.

# The V2 read API base URL (server-side fetch from the V2 HTTP API).
# Defaults to http://127.0.0.1:8787 when unset (see src/lib/v2/api.ts).
PITCHTERMINAL_V2_API=http://127.0.0.1:8787

# Optional: a TEMPORARY deployment base path for migration/testing coexistence
# with the legacy frontend (e.g. /pitchv2). Leave UNSET in production — the V2 app
# owns the root domain and must not permanently live under /v2 or /pitch.
# NEXT_PUBLIC_BASE_PATH=/pitchv2
